{
  "name": "gpt-web-image",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "bin": {
    "gpt-web-image": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:manager",
    "build:manager": "node scripts/copy-manager-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "test:unit": "npm run build && node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "preview:manager": "npm run build && node scripts/preview-manager.mjs",
    "install:user": "npm run build && node scripts/install.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.10.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "playwright-core": "^1.62.0",
    "sharp": "^0.35.3"
  }
}
